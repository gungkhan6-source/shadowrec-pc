{
  "name": "novarec-studio",
  "version": "1.0.0",
  "description": "NovaRec Studio - Professional Game & Screen Recording, Streaming, and Video Editing Suite",
  "main": "electron/main.js",
  "homepage": "./",
  "author": {
    "name": "NovaRec Studio",
    "email": "novarec@example.com"
  },
  "scripts": {
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && electron .\"",
    "react-start": "react-scripts start",
    "build": "react-scripts build",
    "electron-build": "npm run build && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.novarec.studio",
    "productName": "NovaRec Studio",
    "copyright": "Copyright (C) 2026 NovaRec Studio",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "requestedExecutionLevel": "requireAdministrator",
      "publisherName": "NovaRec Studio"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NovaRec Studio",
      "license": "LICENSE.txt"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "native/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/test/**",
      "!node_modules/**/*.md",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.map"
    ],
    "extraResources": [
      { "from": "bin/", "to": "bin/" }
    ]
  },
  "browserslist": {
    "production": [">0.2%", "not dead"],
    "development": ["last 1 chrome version"]
  }
}
